# Google Gemini API key (get one free at https://aistudio.google.com/apikey)
# Without this, the chatbot runs in limited "offline mode".
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model. Defaults to gemini-flash-lite-latest, a
# fast, low-latency rolling alias (~1-2s replies). Heavier "thinking" models
# like gemini-flash-latest can take ~30s, so the lite tier is preferred here.
# The app auto-falls back to other current models if this one is unavailable.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: GitHub personal access token for higher API rate limits on the
# activity/dashboard pages. Works without it (uses fallback data when rate-limited).
GITHUB_TOKEN=your_github_token_here
